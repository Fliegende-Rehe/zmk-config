#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define ADJ 2
#define GAME 3

&lt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

/ {
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <30>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        r_esc {
            bindings = <&kp ESC>;
            key-positions = <31 32 33>;
            layers = <BASE GAME>;
        };

        l_esc {
            bindings = <&kp ESC>;
            key-positions = <26 27 28>;
            layers = <BASE>;
        };

        switch_input {
            bindings = <&kp LS(LALT)>;
            key-positions = <54 55>;
            layers = <BASE>;
        };
    };

    behaviors {
        f1_f11: F11_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp F1>, <&kp F11>;
        };

        f2_f12: F12_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp F2>, <&kp F12>;
        };

        slash_backslash: slash_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BACKSLASH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
            bindings = <
&kp ESC         &kp N1  &kp N2    &kp N3   &kp N4        &kp N5                                    &kp N6         &kp N7        &kp N8     &kp N9     &kp N0            &kp TILDE
&kp TAB         &kp Q   &kp W     &kp E    &kp R         &kp T                                     &kp Y          &kp U         &kp I      &kp O      &kp P             &kp RIGHT_BRACKET
&kp LEFT_SHIFT  &kp A   &kp S     &kp D    &kp F         &kp G                                     &kp H          &kp J         &kp K      &kp L      &kp SEMI          &kp SQT
&kp LCTRL       &kp Z   &kp X     &kp C    &kp V         &kp B    &kp C_MUTE     &kp C_PP          &kp N          &kp M         &kp COMMA  &kp DOT    &slash_backslash  &mt RSHFT LEFT_BRACKET
                        &kp HOME  &kp END  &kp LALT      &kp DEL  &lt 1 SPACE    &lt 1 ENTER       &kp BACKSPACE  &kp RALT  &kp MINUS  &kp EQUAL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        NAV {
            display-name = "NAV";
            bindings = <
&tog GAME   &f1_f11         &f2_f12         &kp F3    &kp F4         &kp F5                    &kp F6  &kp F7            &kp F8                &kp F9             &kp F10  &tog GAME
&kp INSERT  &none           &kp LC(MINUS)   &kp UP    &kp LC(EQUAL)  &none                     &none   &kp LS(LG(LEFT))  &kp UP          &kp LS(LG(RIGHT))  &none    &kp KP_NUM
&kp CAPS    &none           &kp LEFT        &kp DOWN  &kp RIGHT      &none                     &none   &mt LCTRL LEFT    &mt LSHFT DOWN  &mt RALT RIGHT     &none    &kp C_MENU
&tog ADJ    &none           &none           &none     &none          &none   &none     &none   &none   &none             &none                 &none              &none    &tog ADJ
                            &none           &none     &kp LGUI       &none   &trans    &trans  &none   &kp RGUI          &none                 &none
            >;
        };

        ADJ {
            display-name = "ADJ";
            bindings = <
&bootloader  &none  &none            &ext_power EP_TOG  &none            &none                  &none  &none            &ext_power EP_TOG  &none            &none  &bootloader
&none        &none  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG    &rgb_ug RGB_BRI  &none                  &none  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG    &rgb_ug RGB_BRI  &none  &none
&out OUT_TOG        &none  &none            &studio_unlock     &none            &none                  &none  &none            &studio_unlock     &none            &none  &out OUT_TOG
&tog ADJ     &none  &bt BT_SEL 0     &bt BT_CLR         &bt BT_SEL 1       &none  &none    &none  &none   &bt BT_SEL 0     &bt BT_CLR         &bt BT_SEL 1       &none  &tog ADJ
                    &none            &none              &none            &none  &none    &none  &none  &none            &none              &none
            >;
        };

        GAME {
            display-name = "GAME";
            bindings = <
&tog GAME  &kp N1     &kp N2  &kp N3  &kp N4    &kp N5                                  &kp N6     &kp N7    &kp N8    &kp N9     &kp N0   &tog GAME
&kp N6     &kp TAB    &kp Q   &kp W   &kp E     &kp R                                   &kp T      &kp Y     &kp U     &kp I      &kp O    &kp RIGHT_BRACKET
&kp N7     &kp LSHFT  &kp A   &kp S   &kp D     &kp F                                   &kp G      &kp H     &kp J     &kp K      &kp L    &kp SQT
&kp N8     &kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp C_MUTE    &kp C_PP        &kp B      &kp N     &kp UP    &kp COMMA  &kp DOT  &kp LEFT_BRACKET
                      &kp F5  &kp F6    &kp N9  &kp LALT &kp SPACE     &kp ENTER         &tog GAME  &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };
    };
};
