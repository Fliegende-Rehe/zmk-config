if SHIELD_SOFLE_LEFT || SHIELD_SOFLE_RIGHT || SHIELD_SHIELD_SOFLE_DONGLE

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif # SHIELD_SOFLE_LEFT || SHIELD_SOFLE_RIGHT || SHIELD_SHIELD_SOFLE_DONGLE


if SHIELD_SHIELD_SOFLE_DONGLE || SHIELD_SOFLE_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

if ZMK_SPLIT_ROLE_CENTRAL

config ZMK_KEYBOARD_NAME
    default "Sofle"

endif # ZMK_SPLIT_ROLE_CENTRAL

endif # SHIELD_SOFLE_LEFT || SHIELD_SHIELD_SOFLE_DONGLE


if SHIELD_SOFLE_LEFT || SHIELD_SOFLE_RIGHT

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY





if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL




endif
