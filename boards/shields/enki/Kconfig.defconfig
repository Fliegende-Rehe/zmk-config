if SHIELD_ENKI_LEFT || SHIELD_ENKI_RIGHT || SHIELD_ENKI_DONGLE

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif # SHIELD_ENKI_LEFT || SHIELD_ENKI_RIGHT || SHIELD_ENKI_DONGLE


if SHIELD_ENKI_DONGLE || SHIELD_ENKI_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

if ZMK_SPLIT_ROLE_CENTRAL

config ZMK_KEYBOARD_NAME
    default "Enki42"

endif # ZMK_SPLIT_ROLE_CENTRAL

endif # SHIELD_ENKI_LEFT || SHIELD_ENKI_DONGLE
