if SHIELD_SCOLIOSIS_LEFT || SHIELD_SCOLIOSIS_RIGHT || SHIELD_SCOLIOSIS_DONGLE

config ZMK_SPLIT
    default y

config ZMK_BLE
    default y

endif # SHIELD_SCOLIOSIS_LEFT || SHIELD_SCOLIOSIS_RIGHT || SHIELD_SCOLIOSIS_DONGLE


if SHIELD_SCOLIOSIS_DONGLE || SHIELD_SCOLIOSIS_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

if ZMK_SPLIT_ROLE_CENTRAL

config ZMK_KEYBOARD_NAME
    default "Scoliosis34"

endif # ZMK_SPLIT_ROLE_CENTRAL

endif # SHIELD_SCOLIOSIS_LEFT || SHIELD_SCOLIOSIS_DONGLE
